{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redstm-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "TEAM_DOMAIN": "https://redstm-archive-private.cloudflareaccess.com",
    "POLICY_AUD": "fe751d9940fe39ebdf36da5a3e5d3465ef206eb3c59e98f537c5c6df817c0604"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "redstm-archive"
    }
  ]
}
