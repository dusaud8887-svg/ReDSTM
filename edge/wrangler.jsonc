{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redstm-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "TEAM_DOMAIN": "https://redstm-archive-private.cloudflareaccess.com",
    "POLICY_AUD": "fe751d9940fe39ebdf36da5a3e5d3465ef206eb3c59e98f537c5c6df817c0604"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "redstm-archive"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "redstm-control",
      "database_id": "997d0196-c136-410c-b11a-69eff7dc1a75",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
