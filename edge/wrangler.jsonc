{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redstm-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "redstm-archive"
    }
  ]
}
