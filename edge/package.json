{
  "name": "redstm-edge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "wrangler types --check --include-runtime false && node scripts/check-assets.mjs && node scripts/vendor.mjs --check && node scripts/check-syntax.mjs",
    "deploy:backup": "wrangler deploy --config backup/wrangler.jsonc",
    "deploy": "cd .. && uv run python -m scripts.release deploy-cloudflare",
    "dev": "wrangler dev",
    "preflight": "cd .. && uv run python -m scripts.release preflight",
    "test": "node --test",
    "test:e2e": "playwright test --workers=2",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:d1": "node scripts/check-d1-migrations.mjs",
    "check:d1-remote": "node scripts/check-d1-remote-integrity.mjs",
    "lint": "biome lint",
    "vendor": "node scripts/vendor.mjs",
    "precache": "node scripts/vendor.mjs --precache",
    "fonts": "cd .. && uv run --with fonttools==4.66.1 --with brotli==1.2.0 python edge/scripts/build-fonts.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@floating-ui/dom": "1.8.0",
    "@fontsource/gowun-batang": "5.3.0",
    "@leeoniya/ufuzzy": "1.0.19",
    "@playwright/test": "1.63.0",
    "@use-gesture/vanilla": "10.3.1",
    "es-hangul": "2.4.0",
    "esbuild": "0.28.2",
    "idb": "8.0.3",
    "photoswipe": "5.4.4",
    "pretendard": "1.3.9",
    "uqr": "0.1.3",
    "workbox-cacheable-response": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-range-requests": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
