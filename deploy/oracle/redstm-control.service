[Unit]
Description=ReDSTM remote command runner
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=redstm
Group=redstm
WorkingDirectory=/opt/redstm/current
EnvironmentFile=-/etc/redstm/access.env
EnvironmentFile=-/etc/redstm/runtime.env
Environment=RCLONE_CONFIG=/etc/redstm/rclone.conf
ExecStart=/opt/redstm/current/.venv/bin/python -m scripts.control_runner
Restart=no
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/redstm
ReadWritePaths=/srv/redstm
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=64
MemoryMax=700M
# Under the 700M cgroup cap the kernel OOM-kills one process (usually the Scrapy child).
# The default OOMPolicy=stop would then also terminate the runner mid-command, leaving the
# command unreported (runner_interrupted). continue lets the runner observe the dead child
# and finish the command with a truthful failure report instead.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
