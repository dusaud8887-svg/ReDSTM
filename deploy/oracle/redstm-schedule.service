[Unit]
Description=ReDSTM scheduled latest crawl and delta publish
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=redstm
Group=redstm
WorkingDirectory=/opt/redstm/current
EnvironmentFile=-/etc/redstm/access.env
EnvironmentFile=-/etc/redstm/runtime.env
Environment=RCLONE_CONFIG=/etc/redstm/rclone.conf
ExecStart=/opt/redstm/current/.venv/bin/python -m scripts.control_runner --scheduled
Restart=no
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/redstm
ReadWritePaths=/srv/redstm
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=64
MemoryMax=700M
# Match redstm-control.service: survive a child OOM kill so the scheduled run finishes
# with a truthful failure report instead of an unreported interruption.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
